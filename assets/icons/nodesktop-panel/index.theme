[Icon Theme]
Name=Nodesktop Forest
Comment=Compact semantic icons for the Nodesktop dark green desktop
Inherits=Adwaita,hicolor
Directories=scalable/places,scalable/devices,scalable/apps

[scalable/places]
Size=64
Context=Places
Type=Scalable
MinSize=16
MaxSize=256

[scalable/devices]
Size=64
Context=Devices
Type=Scalable
MinSize=16
MaxSize=256

[scalable/apps]
Size=64
Context=Applications
Type=Scalable
MinSize=16
MaxSize=256
