#!/usr/bin/env python3
"""Restore the most recent Nodesktop style backup without clobbering new edits."""

from __future__ import annotations
import argparse, hashlib, json
from pathlib import Path
import shutil

parser = argparse.ArgumentParser()
parser.add_argument("--home", type=Path, default=Path.home())
parser.add_argument("--force", action="store_true")
args = parser.parse_args()
home = args.home.resolve()
pointer = home / ".config/nodesktop/last-backup"
if not pointer.exists():
    raise SystemExit("No style backup is recorded.")
root = Path(pointer.read_text().strip())
manifest = json.loads((root / "manifest.json").read_text())
migrated_checksums = manifest.get("migrated_checksums", {})
for relative, old_digest in manifest["checksums"].items():
    current = home / relative
    backup = root / relative
    if current.exists() and not args.force:
        current_digest = hashlib.sha256(current.read_bytes()).hexdigest()
        backup_digest = hashlib.sha256(backup.read_bytes()).hexdigest()
        migrated_digest = migrated_checksums.get(relative)
        if current_digest not in (old_digest, backup_digest, migrated_digest):
            raise SystemExit(f"Refusing to overwrite a changed file: {current}")
for relative in manifest["checksums"]:
    current = home / relative
    current.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(root / relative, current)
(home / ".config/nodesktop/style-version").write_text(manifest["from"] + "\n")
